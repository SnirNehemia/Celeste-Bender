[node name="Room06" type="Node2D"]
editor_description = "Drop to the dock and hop on the sail. Gust sideways while standing on the deck: no recoil, the sail takes the push and moves the way you blew. Two thorn crowns stick up through the rail: jump over each one as the boat slides under it and land back on the deck (you keep the boat's speed in the air). Two ceiling sentries and one on the far dock shoot at you: reflect their orbs (gusting on deck also pushes the boat!) or outrun them. Jump off at the far dock, past the last sentry."
script = ExtResource("1_7b1ev")
display_title = "6 - Sail Under Fire"
room_size = Vector2(800, 180)

