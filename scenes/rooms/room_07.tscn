[node name="Room07" type="Node2D"]
editor_description = "1) Gust the windmill, then race the 4 s gate: jump and dash through three crystals over spikes, against a head-wind, and through the door. 2) A sentry sits on the high platform: reflect its orbs from below, then climb (jump + down-gusts) up to it; the air below it is dead, no gliding. 3) Jump to the last ledge; a wisp patrols in front of the goal (gust it into the wall, then dash it, or just slip past). Touch the green flag to finish."
script = ExtResource("1_g5hmf")
display_title = "7 - The Gauntlet"
room_size = Vector2(480, 180)

