[node name="Room05" type="Node2D"]
editor_description = "Drop to the low platform and deal with its wisp (gust it into the spikes, or stun it and dash into it). Down-gust jump (Z + Down in the air) up to the high platform and its wisp, then again up and over the spiked wall onto the sentry's ledge (dead air in front of the wall: no gliding). Gust an orb back at the sentry. The gate (pips above it) opens when all three enemies are beaten; the way on is behind it."
script = ExtResource("1_vmiug")
display_title = "5 - Sentry Pass"
room_size = Vector2(480, 180)

