[node name="RoomWaterJ" type="Node2D" unique_id=2091012568]
editor_description = "Stage W8a. Water WETS what it touches: earth and ash turn to MUD (grey rock never gets wet), grass gets wet and won't burn. Throw water at the earth shaft's walls and cling to the mud (hold toward it), then wall-jump up. Wet the grass and fireball it (Q): steam, no fire; the second fireball lights it. On the plateau, gather, wet the earth floor past the ice slope, then slide down: the mud stops you dead before the spikes. Stage W8b, at the far end: wet the earth runway with a ball from its pool, hold 1 away from any water (a frost cursor), steer it onto the wet floor and press 2: an icy coat. Gust onto it and keep your speed over the spike gap. Stage W8c, past that: cross the spike pit on crumbling rock and crumbling ice; each patch breaks 2 s after you land on it, and R brings them back."
script = ExtResource("1_1sh01")
display_title = "Water J: wet tiles, mud, icy coats, crumbling (W8a-W8c)"
room_size = Vector2(1040, 180)
earth_allowed = false
fire_allowed = true
fire_start_pips = 3
water_allowed = true
painted_ground = true

