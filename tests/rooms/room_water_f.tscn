[node name="RoomWaterF" type="Node2D" unique_id=1912149861]
editor_description = "Grid ice: a frozen snake becomes the tiles under its trail (the ghost shows them): flat runs, 45 degree and gentle slopes, upright columns. Raise a snake from the plateau pool (1 in the water, hold 3, lift), draw it up, right and down over the spike pit, freeze it (2): slide down it (hold down: belly slide) and jump off its end. On the shelf, draw a 45 degree slope down to the ground and gust the crate (Z) down it onto the plate."
script = ExtResource("1_0mbkk")
display_title = "Water F: snake lines (I2)"
room_size = Vector2(480, 180)
earth_allowed = false
water_allowed = true
painted_ground = true

