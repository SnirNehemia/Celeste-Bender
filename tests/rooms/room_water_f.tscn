[node name="RoomWaterF" type="Node2D" unique_id=758930022]
editor_description = "Stage W6 ice slides: pins kill you but catch ice. Lay a snake over a pin bed and freeze it (2) into a slide; on ice steeper than 15 degrees you slide (hold down: belly slide, faster). Slides are one-way (jump up through them). Jump off the slide's end over the pit. Freeze a thrown ball over the second pin bed: it sticks as a step. Gust the crate down a slide onto the plate to open the door."
script = ExtResource("1_oq3t4")
display_title = "Water F: ice slides and pins (W6)"
room_size = Vector2(480, 180)
earth_allowed = false
water_allowed = true
painted_ground = true

