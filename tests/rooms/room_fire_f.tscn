[node name="RoomFireF" type="Node2D" unique_id=627225833]
editor_description = "Stage F7 test room. All elements, starts with 5 pips. The LEAVES burn: a lone burning leaf is a harmless ember, 6+ lying together make a bonfire (amber, then a low flame, then tall). 1: fireball the pile, glide over the bonfire: you rise; steer onto the wall. 2: burn the wide pile: the crystal it hid turns orange, but it's in the flame: gust the bonfire apart from close by, then take it (+1). 3: gust the small pile up and fireball the falling leaves: an ember rain lights the grass. 4: fireball the blue gust diamond over the pit: +2; jet across and grab it. R puts it all back."
script = ExtResource("1_aw1oh")
display_title = "Fire F - Bonfires & Air Diamonds"
room_size = Vector2(480, 180)
fire_allowed = true
fire_start_pips = 5

