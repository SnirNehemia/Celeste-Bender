[node name="RoomFireG" type="Node2D" unique_id=1204297459]
editor_description = "Stage F8 test room. All elements, starts with 5 pips. 1: fireball the vine holding the standing plank (over its top): it burns through, the plank topples across the pit. 2: burn one vine of the hanging plank and it swings on the other; burn both and it falls. 3: burn the crate on the plate (wait on the earth while the grass burns): it collapses, the plate lifts, the door opens. 4: a leaf platform (burns away in 0.8 s, harmless) and a sail: gust right to sail over the pit, burn the sail and it coasts to the end. R brings everything back."
script = ExtResource("1_5qajw")
display_title = "Fire G - Vines & Burning Objects"
room_size = Vector2(560, 180)
fire_allowed = true
fire_start_pips = 5

