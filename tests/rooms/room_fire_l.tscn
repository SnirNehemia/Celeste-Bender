[node name="RoomFireL" type="Node2D" unique_id=1415714633]
editor_description = "Stage F11b test room. All elements, starts with 5 pips. A huge earth elephant: its front kills, its back is a ride (60 px up: dash, gust, jet or a column), its tail wiggles, rises and whips. It charges whenever it sees you on its level. 1: climb on and ride over the spikes to the high diamond. 2: lure its charge into the STONE wall (only elephants break it): jump onto the ledge as it comes. 3: burn its tail from the left: it bolts through the thicket. Burn all three spots and it crumbles. R resets."
script = ExtResource("1_acrln")
display_title = "Fire L - Thicket Elephant"
room_size = Vector2(720, 180)
fire_allowed = true
fire_start_pips = 5

