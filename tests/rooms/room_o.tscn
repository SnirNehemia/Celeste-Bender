[node name="RoomO" type="Node2D"]
editor_description = "Reflection range (Stage 8). A sentry hangs from the ceiling and fires at you on the floor. You start in the hiding spot: under the small platform it can't see you. Step out, let an orb come, and gust it at a target: back at the ceiling sentry, at the wisp on the low-right platform, or at the two practice targets (sentries with a ring for an eye that never fire: one hanging under the high-right platform, one on the floor in the right corner). The wisp on the high-left ledge is shielded by its ledge from below: get up high (stand on the hiding platform, jump, down-gust) and reflect from its height. Aim assist picks the target closest to your gust direction (within 45 degrees, in clear view). Dying or R brings everything back."
script = ExtResource("1_room")
display_title = "O - Reflection Range"
solid_rects = Array[Rect2]([Rect2(0, 0, 320, 8), Rect2(0, 0, 8, 180), Rect2(312, 0, 8, 180), Rect2(0, 152, 320, 28), Rect2(56, 128, 48, 8), Rect2(8, 80, 48, 8), Rect2(216, 128, 64, 8), Rect2(248, 48, 56, 8)])

