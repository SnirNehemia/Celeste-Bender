[node name="RoomEarthC" type="Node2D"]
editor_description = "Stage E4/E4a test room. Earth-only. Press S: a rock tears out of the ground ahead of you (leaving a hole) and hops over your head; press S again while it's white (coming back down level with you) for a perfect throw. Aim up-right to stick steps high on the earth wall; the gray pillar shatters rocks. Dig into the thick earth on the left. A column hardens the earth under it. R resets."
script = ExtResource("1_o534a")
display_title = "Earth C - Boulders"
air_allowed = false

