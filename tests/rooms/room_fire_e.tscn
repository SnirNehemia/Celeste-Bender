[node name="RoomFireE" type="Node2D" unique_id=8851547]
editor_description = "Stage F6 test room. All elements, starts with 3 pips. 1: fireball the thicket wall: it glows, burns through and crumbles away. 2: the upper way ends at a gray barrier: burn the thicket floor (fireball it, or jet off it) and drop to the corridor below. 3: a grass fuse runs to a bush that is really an overgrown cover (browner leaves, roots): when the fire reaches it, the whole cover flashes over and opens a chamber with a fire diamond. R brings it all back."
script = ExtResource("1_2s7ob")
display_title = "Fire E - Thicket & Overgrown"
room_size = Vector2(400, 180)
fire_allowed = true
fire_start_pips = 3

