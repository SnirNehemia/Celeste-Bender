[node name="RoomEarthE" type="Node2D" unique_id=1182650165]
editor_description = "Stage E5 test room. Earth-only. Hold A on the earth patch until the shadow crawls off your feet, release: a snake of earth comes out at the shadow; steer it with the arrows, press A (or Jump) to harden it. Steer it into yourself: it throws you off (or crushes you against the ground). Send the shadow down the pit's near wall for a straight bridge. The patch has 12 tiles: one full snake. Raise a wall against the sentry's orbs. R resets."
script = ExtResource("1_lkj7o")
display_title = "Earth E - Snake"
air_allowed = false

