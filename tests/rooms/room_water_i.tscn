[node name="RoomWaterI" type="Node2D" unique_id=2084836004]
editor_description = "Stage W7b. CURRENTS move the water, and what floats rides it. Step into the stream: it carries you right; ride the floating crate over the spiked floor. On the black channel a loop current runs along the surface: freeze a raft (hold 1 at the small pool, steer the ball onto the black water, 2) and surf it across. In the deep pool the surface runs right and the bottom runs back: swim on top, then dive. Swim under the waterfall: it pushes you down. Gust the leaves onto the pool: they float and drift. The leaf platform floats on its rail."
script = ExtResource("1_hxy8k")
display_title = "Water I: currents (W7b)"
room_size = Vector2(536, 180)
earth_allowed = false
water_allowed = true
painted_ground = true

