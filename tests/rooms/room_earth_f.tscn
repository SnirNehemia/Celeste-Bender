[node name="RoomEarthF" type="Node2D" unique_id=1099338942]
editor_description = "One key: A does column AND snake (on everywhere; this room keeps it on even with the global switch off). Quick tap A (shadow still under your feet): a column under you, the super jump, up onto the ledge. Hold A until the shadow crawls off: releasing brings a snake out instead; steer it, A again hardens it. Bridge the spike pit from the ledge's side. R resets."
script = ExtResource("1_6gcw0")
display_title = "Earth F - One Key (A)"
