[node name="RoomM" type="Node2D"]
editor_description = "Puzzle objects playground (Stage 7), scrolls sideways. 1) A leaf pile hides the plate: gust it away (or let the crate plow through it), then gust the crate onto the plate: door A opens. 2) Gust the windmill (up-right from the floor), then get through gate B within 4 s; the ring around the hub shows the time left. 3) Stand on the leaf and gust (any direction) to ride it up its rail, then jump to the ledge. 4) Gust the sail platform right from the ledge, hop on; the wind current carries it to the far ledge. Dying or R resets every object in the room."
