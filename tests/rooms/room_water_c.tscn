[node name="RoomWaterC" type="Node2D" unique_id=819522405]
editor_description = "Stage W3 water hands: hold 1 for slow motion and a ball you steer with the arrows; touch water to gather (up to 4 units); let go of 1 to throw (push it out of the ring for a long throw); Jump drops it. Carry water from the deep pool to the basin. Under water the ball pushes you: keep it leaning on you to swim fast. Stand past the basin and the sentry fires: a full ball eats its orbs."
script = ExtResource("1_jd42g")
display_title = "Water C: water hands (W3)"
earth_allowed = false
water_allowed = true
painted_ground = true

