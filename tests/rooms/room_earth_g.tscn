[node name="RoomEarthG" type="Node2D" unique_id=416903795]
editor_description = "Stage E6 test room. Earth-only, one key. Hold S for a big rock and throw it (S again) at the cracked wall: it breaks into gray pebbles (a small rock just shatters on it). A thrown rock knocks a wisp back and defeats it, and destroys the sentry. A snake out of the floor steered right rams the wisp into the spike pit. Steer a snake up as a wall: the sentry's orbs pop on it. R resets."
script = ExtResource("1_w1yyr")
display_title = "Earth G - Walls & Enemies"
air_allowed = false
one_key_column_snake = true

