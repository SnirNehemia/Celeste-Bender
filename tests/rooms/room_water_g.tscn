[node name="RoomWaterG" type="Node2D" unique_id=423864874]
editor_description = "Grid ice. Steer the ball into the waterfall: the ghost is one tall column. Freeze it (2): an ice wall from the spout to the basin, and the spout stops. Wall-jump up between the ice and the tower. Then rest a ball on the big pool's surface: the ghost is a flat slab; freeze it into a RAFT (rafts work on any water), ride it and gust back (Z) to push it across."
script = ExtResource("1_ps3bk")
display_title = "Water G: waterfall walls and rafts (I2, I3)"
room_size = Vector2(480, 180)
earth_allowed = false
water_allowed = true
painted_ground = true

