[node name="RoomFireJ" type="Node2D" unique_id=698126044]
editor_description = "Stage F11 test room. All elements, starts with 5 pips. 1: burn the grass (or fireball the wisp): it walks into the fire and burns up. 2: fireball the sentry; fireball an orb and both burst. 3: a vine monkey runs over spikes unharmed (cross on the platform above). 4: light the leaf pile, then gust the ledge monkey into the hot air: it floats up. 5: fireball the monkey that hops the pit: it runs as a torch and lights the grass; light it on the far side for the leaf pile. Gust a burning monkey to put it out. R brings everything back."
script = ExtResource("1_wj3o2")
display_title = "Fire J - Enemies & Vine Monkey"
room_size = Vector2(640, 180)
fire_allowed = true
fire_start_pips = 5

