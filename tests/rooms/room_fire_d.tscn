[node name="RoomFireD" type="Node2D" unique_id=2036587611]
editor_description = "Stage F5 test room. All elements, starts with 2 pips. 1: fireball the grassy step: the fire runs along the grass, up the step and on to the brazier, which opens the door. Wait on the gray ledge while it passes; ash is safe to walk on. 2: grab the double diamond and jet right along the floor: the plume lights each grass patch behind you. R puts all the grass back."
