[node name="RoomWaterE" type="Node2D" unique_id=2033543952]
editor_description = "Grid ice. Hold 1 and gather: the ball is a square, and a ghost shows the ice 2 would make, snapped to the tiles (red cells are blocked). Freeze a 2x2 block against the ledge's foot: ice touching rock stays. Over the chasm the ghost is dashed: ice hanging in mid-air crumbles 2 s after you touch it. Freeze a step over the spikes, land on it and jump on before it breaks."
script = ExtResource("1_v8rx0")
display_title = "Water E: blocks and crumbling ice (I1, I4)"
