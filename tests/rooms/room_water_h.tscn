[node name="RoomWaterH" type="Node2D" unique_id=872098671]
editor_description = "Stage W7a. BLACK water kills, can't be gathered or frozen. Carry clean water to it: hold 1 by the left pool, gather, steer the ball down onto the black channel and freeze it (2) into a RAFT. Ride it and gust back (Z): the raft takes the recoil. Jumping off pushes it back too. Then throw a ball onto the black pit: clean water floats on black like oil for a moment; freeze it (2) into a stepping stone. Last, painted ice slopes (22.5 degrees down, a 45 degree ramp): slide down and launch off the ramp over the spikes."
script = ExtResource("1_modjm")
display_title = "Water H: black water and rafts (W7a)"
room_size = Vector2(584, 180)
earth_allowed = false
water_allowed = true
painted_ground = true

