[node name="RoomFireM" type="Node2D" unique_id=2860879]
editor_description = "Stage F12 test room. All elements, starts with 5 pips. The SHELL: only a big rock kills it (thrown, or dropped from 2+ tiles); a small rock staggers it; fire, spikes and crushing do nothing; fireballs and orbs BOUNCE off it (fireballs also bounce off anything that doesn't burn). 1: fireball it, burn its grass, rock it. 2: drop a big rock on it from the ledge. 3: burn the thicket bridge under it. 4: watch the sentry's orbs bounce off it. 5-6: a wisp, a monkey and an elephant to try every element on. R resets."
script = ExtResource("1_bxxid")
display_title = "Fire M - Shell & Element Table"
room_size = Vector2(720, 180)
fire_allowed = true
fire_start_pips = 5

