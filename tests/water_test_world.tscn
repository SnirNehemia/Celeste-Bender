[node name="WaterTestWorld" type="Node2D" node_paths=PackedStringArray("player", "camera")]
editor_description = "Water chapter test rooms (Stages W1+): A = water bodies (waves, spills, a staircase, joined pools, floating; 8 poke, 9 bucket, 0 drain). B = loose water (6 throws a ball; a waterfall and wheel, a stream, drains, an earth patch that soaks). C = water hands (hold 1, steer, gather, throw; two pools and a sentry). Rooms are generated by tools/build_water_rooms.gd. Run this scene with F6 in the editor, or: godot --path . res://tests/water_test_world.tscn"
