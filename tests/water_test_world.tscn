[node name="WaterTestWorld" type="Node2D" node_paths=PackedStringArray("player", "camera")]
editor_description = "Water chapter test rooms (Stages W1+): A = water bodies (waves, spills, a staircase, joined pools, floating; 8 poke, 9 bucket, 0 drain). B = loose water (6 throws a ball; a waterfall and wheel, a stream, drains, an earth patch that soaks). C = water hands (hold 1, steer, gather, throw; two pools and a sentry). D = water snake (ease the ball up out of a pool; a crate on a pillar to sweep off; a wide pool). E = freeze and ice (2: freeze a thrown ball into a step, freeze a pool and long-jump spikes, a snake pillar, painted ice, a waterfall and a stream to freeze). F = ice slides and pins (lay a snake over pins and freeze it into a slide, ride it and jump the pit; freeze a ball over pins into a step; gust a crate down a slide onto a plate). G = the re-planned, predictable ice (ice hangs where it froze; a trail snake snapped to 22.5 degrees drawn over a spike pit as a slide; a thrown ball frozen in the air as a step; a puck gusted along a frozen pool onto a plate). H = black water and rafts (black water kills; freeze clean water on it into a raft, ride it and gust; a slick thrown onto a black pit frozen into a stepping stone; painted ice slopes down to a lip over spikes). I = currents (a stream with a floating crate over spikes; a loop current on a black channel to surf a raft; a deep loop pool: surface one way, bottom the other; a waterfall; floating leaves; a leaf platform floating on its rail). Rooms are generated by tools/build_water_rooms.gd. Run this scene with F6 in the editor, or: godot --path . res://tests/water_test_world.tscn"
script = ExtResource("1_manager")
player = NodePath("Player")
camera = NodePath("RoomCamera")

